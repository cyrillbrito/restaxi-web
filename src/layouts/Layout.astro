---
import '@fontsource-variable/inter';
import type { Locale } from '../i18n/translations';
import { getTranslations, locales, localePath, SITE_URL } from '../i18n/utils';

interface Props {
  locale: Locale;
  notFound?: boolean;
}

const { locale, notFound = false } = Astro.props;
const t = getTranslations(locale);

const currentUrl = `${SITE_URL}${localePath(locale)}`;
const ogImage = `${SITE_URL}/og-image-v2.png`;
const ogLocales: Record<Locale, string> = { pt: 'pt_PT', fr: 'fr_FR', en: 'en_GB' };

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_URL}/#business`,
  name: 'Táxis Restauração',
  description: t.DESCRIPTION_TAG,
  url: `${SITE_URL}/`,
  telephone: '+351964468494',
  email: 'taxisrestauracao@hotmail.com',
  foundingDate: '2000',
  knowsLanguage: ['pt', 'fr', 'en'],
  logo: `${SITE_URL}/logo.png`,
  image: ogImage,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Olhão',
    postalCode: '8700',
    addressRegion: 'Faro',
    addressCountry: 'PT',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 37.0256,
    longitude: -7.8411,
  },
  areaServed: [
    'Olhão',
    'Faro',
    'Aeroporto de Faro',
    'Tavira',
    'Fuseta',
    'Moncarapacho',
    'Quelfes',
    'Pechão',
    'Algarve',
  ].map((name) => ({ '@type': 'Place', name })),
  makesOffer: {
    '@type': 'Offer',
    itemOffered: { '@type': 'TaxiService', name: t.SERVICE_1_TITLE },
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.DESCRIPTION_TAG} />
    <meta name="theme-color" content="#262626" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <Fragment>
        <!-- Canonical & Language Alternates -->
        <link rel="canonical" href={currentUrl} />
        {locales.map((l) => (
          <link rel="alternate" href={`${SITE_URL}${localePath(l)}`} hreflang={l} />
        ))}
        <link rel="alternate" href={`${SITE_URL}/`} hreflang="x-default" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={currentUrl} />
        <meta property="og:title" content={t.TITLE_TAG} />
        <meta property="og:description" content={t.DESCRIPTION_TAG} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t.LOGO_ALT} />
        <meta property="og:locale" content={ogLocales[locale]} />
        {locales
          .filter((l) => l !== locale)
          .map((l) => (
            <meta property="og:locale:alternate" content={ogLocales[l]} />
          ))}
        <meta property="og:site_name" content="Táxis Restauração" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={t.TITLE_TAG} />
        <meta name="twitter:description" content={t.DESCRIPTION_TAG} />
        <meta name="twitter:image" content={ogImage} />
      </Fragment>
    )}

    <title>{notFound ? 'Página não encontrada | Táxis Restauração' : t.TITLE_TAG}</title>

    <!-- Structured Data -->
    {!notFound && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    /* Taken from the logo: taxi yellow on charcoal */
    --color-primary: #262626;
    --color-primary-light: #333333;
    --color-accent: #fed136;
    --color-accent-dark: #f2c200;
    --color-text: #262626;
    --color-text-light: #5c5c5c;
    --color-border: #e7e5e0;
    --color-bg: #ffffff;
    --color-bg-alt: #f7f6f3;
    --font-sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  /* Keep anchor targets clear of the fixed navbar */
  [id] {
    scroll-margin-top: 4.5rem;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
  }
</style>
