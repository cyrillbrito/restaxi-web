---
import type { Locale } from '../i18n/translations';
import { getTranslations, localePath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const homeHref = localePath(locale);
const year = new Date().getFullYear();

const PHONE = '+351964468494';
const PHONE_DISPLAY = '+351 964 468 494';
const WHATSAPP = 'https://wa.me/351964468494';
const EMAIL = 'taxisrestauracao@gmail.com';

const phonePath =
  'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z';
const whatsappPath =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z';

// Simple line icons (Lucide style), 24x24 viewBox
const services = [
  {
    title: t.SERVICE_1_TITLE,
    desc: t.SERVICE_1_DESC,
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: t.SERVICE_2_TITLE,
    desc: t.SERVICE_2_DESC,
    icon: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  },
  {
    title: t.SERVICE_3_TITLE,
    desc: t.SERVICE_3_DESC,
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    title: t.SERVICE_4_TITLE,
    desc: t.SERVICE_4_DESC,
    icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  },
];

const reasons = [
  { stat: '2000', title: t.WHY_1_TITLE, desc: t.WHY_1_DESC },
  { stat: 'A/C', title: t.WHY_2_TITLE, desc: t.WHY_2_DESC },
  { stat: '€', title: t.WHY_3_TITLE, desc: t.WHY_3_DESC },
  { stat: '24/7', title: t.WHY_4_TITLE, desc: t.WHY_4_DESC },
];
---

<nav class="navbar">
  <div class="container nav-content">
    <a href={homeHref} class="logo">
      <img src="/logo-96.webp" alt={t.LOGO_ALT} width="40" height="40" />
      <span>Táxis Restauração</span>
    </a>
    <div class="nav-right">
      <a href="#services" class="nav-link hide-mobile">{t.NAV_SERVICES}</a>
      <a href="#about" class="nav-link hide-mobile">{t.NAV_ABOUT}</a>
      <a href="#contacts" class="nav-link hide-mobile">{t.NAV_CONTACTS}</a>
      <a href={`tel:${PHONE}`} class="nav-phone hide-mobile" data-location="nav">{PHONE_DISPLAY}</a>
      <LanguageSwitcher currentLocale={locale} />
    </div>
  </div>
</nav>

<header class="hero">
  <div class="container hero-content">
    <p class="eyebrow">{t.HERO_BADGE}</p>
    <h1>{t.MAIN_HEADER}</h1>
    <p class="hero-description">{t.MAIN_HEADER_DESCRIPTION}</p>
    <div class="hero-cta">
      <a href={`tel:${PHONE}`} class="btn btn-primary" data-location="hero">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d={phonePath}></path>
        </svg>
        {t.CTA_CALL}<span class="btn-number">· {PHONE_DISPLAY}</span>
      </a>
      <a
        href={WHATSAPP}
        target="_blank"
        rel="noopener"
        class="btn btn-secondary"
        data-location="hero"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={whatsappPath}></path>
        </svg>
        {t.CTA_WHATSAPP}
      </a>
    </div>
  </div>
</header>

<main>
  <section id="services" class="section">
    <div class="container">
      <div class="section-header">
        <h2>{t.SERVICES_HEADER}</h2>
        <p>{t.SERVICES_SUBTITLE}</p>
      </div>
      <div class="services-grid">
        {
          services.map((s) => (
            <div class="service-card">
              <div class="service-icon">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={s.icon}
                />
              </div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>{t.WHY_US_HEADER}</h2>
        <p>{t.WHY_US_SUBTITLE}</p>
      </div>
      <div class="features-grid">
        {
          reasons.map((r) => (
            <div class="feature">
              <div class="feature-stat">{r.stat}</div>
              <h3>{r.title}</h3>
              <p>{r.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container about-content">
      <div class="about-text">
        <h2>{t.ABOUT_HEADER}</h2>
        <p>{t.ABOUT_TEXT_1}</p>
        <p>{t.ABOUT_TEXT_2}</p>
        <p>{t.ABOUT_TEXT_3}</p>
      </div>
      <div class="about-image">
        <img src="/logo.png" alt={t.LOGO_ALT} width="256" height="256" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="contacts" class="section section-dark">
    <div class="container">
      <div class="section-header light">
        <h2>{t.CONTACTS_HEADER}</h2>
        <p>{t.CONTACTS_SUBTITLE}</p>
      </div>
      <div class="contact-grid">
        <a href={`tel:${PHONE}`} class="contact-card" data-location="contacts">
          <h3>{t.PHONE_HEADER}</h3>
          <p class="contact-value">{PHONE_DISPLAY}</p>
          <p class="contact-desc">{t.PHONE_DESCRIPTION}</p>
        </a>
        <a href={`mailto:${EMAIL}`} class="contact-card" data-location="contacts">
          <h3>{t.EMAIL_HEADER}</h3>
          <p class="contact-value">{EMAIL}</p>
          <p class="contact-desc">{t.EMAIL_DESCRIPTION}</p>
        </a>
        <div class="contact-card static">
          <h3>{t.ADDRESS_HEADER}</h3>
          <p class="contact-value">{t.ADDRESS_DESC}</p>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <strong>Táxis Restauração</strong>
      <span>{t.FOOTER_TAGLINE}</span>
    </div>
    <p class="footer-copyright">© {year} Táxis Restauração. {t.RIGHTS_RESERVED}</p>
  </div>
</footer>

<!-- Mobile: always-visible booking bar -->
<div class="sticky-cta">
  <a href={`tel:${PHONE}`} class="btn btn-primary" data-location="sticky">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d={phonePath}></path>
    </svg>
    {t.STICKY_CALL}
  </a>
  <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-whatsapp" data-location="sticky">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={whatsappPath}></path>
    </svg>
    WhatsApp
  </a>
</div>

<style>
  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Navbar */
  .navbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .logo img {
    border-radius: 8px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-light);
    font-weight: 500;
    font-size: 0.925rem;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-phone {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.925rem;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    background: var(--color-accent);
  }

  .nav-phone:hover {
    background: var(--color-accent-dark);
  }

  .hide-mobile {
    display: none;
  }

  @media (min-width: 860px) {
    .hide-mobile {
      display: block;
    }
  }

  /* Hero */
  .hero {
    background: var(--color-primary);
    color: white;
    padding: calc(64px + 5rem) 0 5rem;
    border-bottom: 6px solid var(--color-accent);
  }

  @media (min-width: 768px) {
    .hero {
      padding: calc(64px + 7rem) 0 7rem;
    }
  }

  .hero-content {
    max-width: 1120px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 0 0 1.25rem;
    max-width: 16ch;
  }

  .hero-description {
    font-size: 1.125rem;
    max-width: 38rem;
    margin: 0 0 2.25rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.4rem;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    font-size: 1rem;
    transition: background-color 0.15s;
  }

  @media (max-width: 559px) {
    .hero-cta .btn {
      flex: 1 1 100%;
    }
    .btn-number {
      display: none;
    }
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .btn-primary:hover {
    background: var(--color-accent-dark);
  }

  .btn-secondary {
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Sections */
  .section {
    padding: 5rem 0;
  }

  .section-alt {
    background: var(--color-bg-alt);
  }

  .section-dark {
    background: var(--color-primary);
    color: white;
  }

  .section-header {
    max-width: 40rem;
    margin: 0 0 2.5rem;
  }

  .section-header h2,
  .about-text h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  .section-header p {
    color: var(--color-text-light);
    margin: 0;
    font-size: 1.075rem;
  }

  .section-header.light p {
    color: rgba(255, 255, 255, 0.7);
  }

  /* Services */
  .services-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .service-card {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .service-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .service-card h3 {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }

  .service-card p {
    margin: 0;
    color: var(--color-text-light);
    font-size: 0.975rem;
  }

  /* Why us */
  .features-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .feature {
    border-top: 3px solid var(--color-accent);
    padding-top: 1.25rem;
  }

  .feature-stat {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .feature h3 {
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  .feature p {
    margin: 0;
    color: var(--color-text-light);
    font-size: 0.95rem;
  }

  /* About */
  .about-content {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-content {
      grid-template-columns: 3fr 2fr;
    }
  }

  .about-text h2 {
    margin-bottom: 1.25rem;
  }

  .about-text p {
    color: var(--color-text-light);
    margin: 0 0 1rem;
    line-height: 1.75;
    max-width: 38rem;
  }

  .about-image {
    display: flex;
    justify-content: center;
  }

  .about-image img {
    width: 240px;
    border-radius: 20px;
  }

  /* Contact */
  .contact-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .contact-card {
    display: block;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    text-decoration: none;
    color: white;
    transition: border-color 0.15s;
  }

  a.contact-card:hover {
    border-color: var(--color-accent);
  }

  .contact-card h3 {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .contact-value {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    overflow-wrap: anywhere;
  }

  .contact-desc {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.65);
  }

  /* Footer */
  .footer {
    background: #1a1a1a;
    color: rgba(255, 255, 255, 0.6);
    padding: 2rem 0 calc(2rem + 76px);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .footer {
      padding-bottom: 2rem;
    }
  }

  .footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .footer-brand {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .footer-brand strong {
    color: white;
  }

  .footer-copyright {
    margin: 0;
  }

  /* Sticky mobile call bar */
  .sticky-cta {
    position: fixed;
    inset: auto 0 0;
    z-index: 999;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem calc(0.625rem + env(safe-area-inset-bottom));
    background: white;
    border-top: 1px solid var(--color-border);
  }

  .btn-whatsapp {
    background: #25d366;
    color: #0b3d1f;
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
